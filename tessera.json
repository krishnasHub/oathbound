{
  "maxParallel": 4,
  "_doc": "How Tessera's tools (unreal/Plugins/Tessera/Tools/Tessera.ps1, via play.ps1) build, test and package this game. The command-line prefix (RPG) comes from unreal/Config/DefaultGame.ini [Tessera].",
  "engine": "5.8",
  "project": "unreal/Oathbound.uproject",
  "dist": "Dist",
  "data": { "source": "data/game-data.json", "target": "unreal/Content/Data/game-data.json", "sync": "tools/sync-data.js" },
  "prepare": {
    "scripts": [ "unreal/Tools/fix_material_usage.py", "unreal/Tools/create_materials.py", "unreal/Tools/import_pixel.py" ],
    "needs": [ "unreal/Content/RPG/Materials/M_RPG_Glow.uasset", "unreal/Content/RPG/Materials/M_RPG_Sprite.uasset" ]
  },
  "art": { "build": "tools/pixelart/build_all.py" },
  "tests": {
    "combat": "-RPGClass=knight", "block": "-RPGClass=knight", "elder": "-RPGClass=knight", "bridge": "-RPGClass=knight",
    "mage": "-RPGClass=mage -RPGHour=22", "thief": "-RPGClass=thief", "walk": "-RPGClass=knight", "picker": "-RPGClass=mage",
    "smoke": "-RPGClass=thief", "pause": "-RPGClass=knight", "click": "-RPGClass=knight",
    "frost": "-RPGClass=mage", "barrier": "-RPGClass=mage", "night": "-RPGClass=mage -RPGHour=23", "scars": "-RPGClass=mage", "ghost": "-RPGClass=knight -RPGGhostScared", "talk": "-RPGClass=knight", "mood": "-RPGClass=knight", "skeletons": "-RPGClass=scholar", "brute": "-RPGClass=scholar", "trader": "-RPGClass=scholar", "cave": "-RPGClass=knight", "palette": "-RPGClass=knight -RPGHour=13", "palette_night": "-RPGClass=knight -RPGHour=23", "pacifist": "-RPGClass=scholar", "spree": "-RPGClass=knight", "tour_knight": "-RPGClass=knight", "tour_mage": "-RPGClass=mage", "tour_thief": "-RPGClass=thief", "tour_scholar": "-RPGClass=scholar", "sleep": "-RPGClass=knight -RPGHour=13", "heist": "-RPGClass=thief -RPGHour=23", "lockpick": "-RPGClass=thief -RPGHour=13", "nighteyes": "-RPGClass=thief -RPGHour=23", "crouch": "-RPGClass=thief -RPGHour=13", "burrow": "-RPGClass=scholar -RPGHour=13", "shifts": "-RPGClass=scholar -RPGHour=23", "linger": "-RPGClass=thief -RPGHour=13", "beds": "-RPGClass=thief -RPGHour=23"
  },
  "shots": {
    "out": "docs/screenshots",
    "list": {
      "01-title":         { "at": 1.5,  "args": "" },
      "02-select-mage":   { "at": 10.6, "args": "-RPGAutoSelect=mage" },
      "03-select-thief":  { "at": 13.4, "args": "-RPGAutoSelect=thief" },
      "04-select-knight": { "at": 11.5, "args": "-RPGAutoSelect=knight" },
      "05-village-day":   { "at": 9,    "args": "-RPGClass=knight -RPGHour=13" },
      "06-golden-hour":   { "at": 9,    "args": "-RPGClass=mage -RPGSex=female -RPGHour=18.6" },
      "07-deep-night":    { "at": 9,    "args": "-RPGClass=thief -RPGHour=22.5" },
      "08-bridge-duel":   { "at": 4.5,  "args": "-RPGClass=knight -RPGTest=bridge" },
      "09-arrow-flight":  { "at": 1.25, "args": "-RPGClass=thief -RPGTest=thief" },
      "10-conversation":  { "at": 6,    "args": "-RPGClass=knight -RPGTest=elder", "png": "elder" },
      "11-ability-pick":  { "at": 1.0,  "args": "-RPGClass=mage -RPGTest=picker" },
      "12-bright-village": { "at": 14,   "args": "-RPGClass=knight -RPGHour=13 -RPGTest=palette", "png": "mood_bright_day" },
      "13-dark-mood":      { "at": 6,   "args": "-RPGClass=knight -RPGHour=13 -RPGTest=palette", "png": "mood_dark_day" },
      "14-old-mine":       { "at": 19.5, "args": "-RPGClass=knight -RPGTest=tour_knight", "png": "tour_knight_6_brute_fight" },
      "15-grave-rest":     { "at": 6.4,  "args": "-RPGClass=scholar -RPGTest=skeletons", "png": "skeleton_rest" },
      "16-grot-miner":     { "at": 26.5, "args": "-RPGClass=scholar -RPGTest=trader", "png": "grot_carrying" }
    }
  }
}
